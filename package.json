{
  "name": "preflight",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "audit:prod": "pnpm audit --prod",
    "demo:buyer": "tsx scripts/demo-buyer.ts"
  },
  "devDependencies": {
    "@x402/evm": "2.32.0",
    "@x402/fetch": "2.32.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "viem": "2.58.4",
    "typescript-eslint": "^8.74.0"
  }
}
